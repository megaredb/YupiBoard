{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node tooling/generate-route-tree.mjs && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write --ignore-path tooling/prettierignore .",
    "format:check": "prettier --check --ignore-path tooling/prettierignore .",
    "fix": "pnpm lint:fix && pnpm format",
    "knip": "knip --config tooling/knip.json",
    "depcruise": "node tooling/depcruise.mjs",
    "i18n:check": "node tooling/check-i18n.mjs",
    "check:platform": "node tooling/check-platform.mjs",
    "api:generate": "orval",
    "cap:sync": "pnpm build && cap sync android",
    "cap:android": "cap open android",
    "cap:build": "pnpm cap:sync && node tooling/build-android.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm depcruise && pnpm i18n:check && pnpm check:platform"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.6",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.18",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "~8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.44.1",
    "orval": "^8.43.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  },
  "prettier": "./tooling/prettier.json"
}
