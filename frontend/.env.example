# Frontend variables. Vite reads them from the repository root `.env` (see `envDir` in
# vite.config.ts). Every `VITE_*` value ends up in the public bundle: never put secrets here.

# Backend origin, without a trailing slash. Required.
VITE_API_BASE_URL=https://api.yupiboard.localhost

# Backend origin used by the Android app. Optional: falls back to VITE_API_BASE_URL. For local
# device testing keep the port: `pnpm cap:run` forwards the device's port to Traefik's 443.
VITE_ANDROID_API_BASE_URL=https://api.yupiboard.localhost:8443

# Public web origin used to build shareable links (the Android app origin is not shareable). Required.
VITE_PUBLIC_WEB_URL=https://yupiboard.localhost

# Google OAuth web client id. Optional: without it the Google button reports that sign-in is unavailable.
VITE_GOOGLE_CLIENT_ID=
